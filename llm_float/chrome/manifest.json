{
  "manifest_version": 3,
  "name": "LLM Float Orb",
  "description": "Floating AI assistant orb",
  "version": "1.0",
  "options_page": "options.html",
  "permissions": ["storage", "tabs", "windows"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["orb.css"],
      "run_at": "document_idle"
    }
  ]
}
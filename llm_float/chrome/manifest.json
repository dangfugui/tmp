{
  "manifest_version": 3,
  "name": "LLM Float 悬浮助手",
  "description": "悬浮球 AI 聊天助手（QwenPaw 直连，核心 UI 不依赖 Python）",
  "version": "0.2.0",
  "options_page": "options/options.html",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ui/*", "options/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": { "default_title": "LLM Float" }
}

{
  "manifest_version": 3,
  "name": "LLM Float 悬浮助手",
  "description": "悬浮球 AI 聊天助手：支持 QwenPaw / OpenAI 兼容 LLM 两种模式，含轻量 agent 工具（页面操作 + 授权目录读写），核心 UI 不依赖 Python",
  "version": "0.8.1",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LLM Float",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/utils.js",
        "content/core.js",
        "content/features/agent.js",
        "content/features/chat.js",
        "content/features/tts.js",
        "content/features/asr.js",
        "content/main.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/*",
        "data/*",
        "design_preview.html",
        "design-preview.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
